{
  "name": "sanad-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test:all",
    "test:backend": "npm --prefix backend test",
    "test:mobile": "npm --prefix mobile test",
    "test:integration": "npx tsx --tsconfig backend/tsconfig.json --test 'testing/**/*.test.ts'",
    "test:security": "npx tsx --tsconfig backend/tsconfig.json --test 'testing/security/**/*.test.ts'",
    "test:all": "npm run test:backend && npm run test:mobile && npm run test:security && npm run test:integration",
    "ci:security-gate": "npm run typecheck && npm run depcruise && npm run test:security",
    "depcruise": "NODE_PATH=backend/node_modules npx dependency-cruiser --config .dependency-cruiser.cjs backend/packages/*/src",
    "typecheck": "npm run typecheck:all",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:mobile": "npm --prefix mobile run typecheck",
    "typecheck:all": "npm run typecheck:backend && npm run typecheck:mobile"
  }
}
